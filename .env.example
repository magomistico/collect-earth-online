# ========================================================
# INAB · SIG - Variables de Configuración de Despliegue
# ========================================================

# Base de Datos PostgreSQL / PostGIS
DB_HOST=db
DB_PORT=5432
DB_NAME=ceo
DB_USER=ceo
DB_PASSWORD=ceo_secret_password
DB_ADMIN_PASSWORD=ceo_secret_password

# Puerto del Servidor Web
PORT=8080

# Llave de Sesión Encriptada (debe tener exactamente 16 caracteres)
SESSION_KEY=inabsigvalidacio

# Llaves de Proveedores Satelitales y Geoespaciales (Opcionales)
# MAPBOX_TOKEN=pk.eyJ1IjoiaW5hYi...
# NICFI_KEY=...
# GEE_ACCOUNT=...
# GEE_KEY_PATH=...
